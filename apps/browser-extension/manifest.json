{
  "manifest_version": 3,
  "name": "VK Dub Studio Bridge",
  "version": "2.1.16",
  "description": "Microsoft Edge & Chrome Bridge for VK Dub Studio Automation (ChatGPT & Vbee)",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "cookies",
    "downloads",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://*.openai.com/*",
    "*://vbee.vn/*",
    "*://*.vbee.vn/*",
    "*://studio.vbee.vn/*",
    "*://*.studio.vbee.vn/*",
    "*://127.0.0.1/*",
    "*://localhost/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://*.openai.com/*"
      ],
      "js": ["content/chatgptAdapter.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://vbee.vn/*",
        "*://*.vbee.vn/*",
        "*://studio.vbee.vn/*",
        "*://*.studio.vbee.vn/*"
      ],
      "js": ["content/vbeeAdapter.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "VK Dub Studio Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
